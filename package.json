{
	"name": "@netframe/shared",
	"version": "0.6.0",
	"description": "Shared chrome, design tokens and auth for the Netframe apps.",
	"license": "UNLICENSED",
	"private": false,
	"type": "module",
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./auth/client": {
			"types": "./dist/auth/client/index.d.ts",
			"svelte": "./dist/auth/client/index.js"
		},
		"./auth/server": {
			"types": "./dist/auth/server/index.d.ts",
			"default": "./dist/auth/server/index.js"
		},
		"./consent": {
			"types": "./dist/consent/index.d.ts",
			"default": "./dist/consent/index.js"
		},
		"./styles/tokens.css": "./dist/styles/tokens.css",
		"./theme": {
			"types": "./dist/theme/index.d.ts",
			"default": "./dist/theme/index.js"
		},
		"./ui": {
			"types": "./dist/ui/index.d.ts",
			"svelte": "./dist/ui/index.js"
		}
	},
	"scripts": {
		"build": "svelte-package",
		"prepare": "svelte-package",
		"check": "svelte-check --tsconfig ./tsconfig.json"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.70.3",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "*",
		"@sveltejs/package": "^2.3.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"lucide-svelte": "^0.468.0",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	}
}
